# Zephyr build output
build/

# Python
__pycache__/
*.pyc
.venv/

# Reference docs (vendor PDFs/datasheets — only README.md is tracked)
docs/reference/*
!docs/reference/README.md

# KiCad user-local project rules (per-user UI state, not project config)
*.kicad_prl

# KiCad MCP working files (visual diffs, temp state)
pcb/phone/.kicad-mcp/

# KiCad export output (schematic renders, etc. — regenerable)
pcb/phone/output/

# ERC reports and kicad-cli temp output (regenerable, not source of truth)
pcb/phone/erc_*.txt
pcb/phone/kicad_err*.txt
pcb/phone/kicad_out*.txt
pcb/phone/kicad_stderr*.txt
pcb/phone/kicad_stdout*.txt

# Temp Python scripts used during schematic generation (kept only while working)
pcb/phone/uuids.txt
pcb/phone/lib_symbols_template.txt

# Temp analysis/fix scripts (one-off ERC debugging, not part of the build)
pcb/phone/analyze_*.py
pcb/phone/categorize_*.py
pcb/phone/check_*.py
pcb/phone/extract_pins_temp.py
pcb/phone/find_*.py
pcb/phone/fix_all_easyeda_symbols.py
pcb/phone/fix_codec_symbols.py
pcb/phone/fix_keypad_*.py
pcb/phone/fix_lib_mismatch.py
pcb/phone/fix_off_grid.py
pcb/phone/flip_*.py
pcb/phone/gen_display_sch.py
pcb/phone/gen_keypad_sch.py
pcb/phone/gen_modem_sch.py
pcb/phone/gen_sim_sd.py
pcb/phone/inspect_keypad.py
pcb/phone/list_pwr.py
pcb/phone/parse_erc.py
pcb/phone/parse_keypad.py
pcb/phone/remove_keypad_nc.py
pcb/phone/rewire_keypad.py
pcb/phone/trace_codec_nets.py
pcb/phone/cleanup_mcu*.py
pcb/phone/bom_test.csv

